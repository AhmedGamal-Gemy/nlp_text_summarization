flowchart LR
    subgraph INPUT["INPUT"]
        A["📄 Raw Article<br/>~700 words"]
    end

    subgraph SENTENCE["1️⃣ SENTENCE SPLITTING"]
        S1["NLTK sent_tokenize()"]
        S2["Split into sentences"]
        S3["List of N sentences"]
    end

    subgraph SCORING["2️⃣ SCORING"]
        subgraph TFIDF["TF-IDF Score"]
            T1["Fit TfidfVectorizer"]
            T2["Get vocabulary"]
            T3["TF × IDF per term"]
            T4["Sum per sentence"]
            T5["Normalize scores"]
        end

        subgraph EMBED["Embedding Score"]
            E1["Load all-MiniLM-L6-v2"]
            E2["Encode each sentence"]
            E3["Encode full article"]
            E4["Cosine similarity<br/>sentence ↔ article"]
            E5["Normalize scores"]
        end
    end

    subgraph COMBINE["3️⃣ COMBINE SCORES"]
        C1["TF-IDF Score × 0.5"]
        C2["Embedding Score × 0.5"]
        C3["Final Score = Sum"]
    end

    subgraph SELECT["4️⃣ SELECT TOP-K"]
        R["Rank sentences<br/>by score"]
        K["Select top K sentences"]
        SORT["Sort by original<br/>position"]
    end

    subgraph OUTPUT["OUTPUT"]
        O["Extractive Summary<br/>~50 words"]
    end

    INPUT --> SENTENCE
    SENTENCE --> S1
    S1 --> S2
    S2 --> S3

    S3 --> TFIDF
    S3 --> EMBED

    TFIDF --> T1 --> T2 --> T3 --> T4 --> T5
    EMBED --> E1 --> E2 --> E3 --> E4 --> E5

    T5 --> C1
    E5 --> C2
    C1 --> C3
    C2 --> C3

    C3 --> SELECT
    SELECT --> R --> K --> SORT --> OUTPUT

