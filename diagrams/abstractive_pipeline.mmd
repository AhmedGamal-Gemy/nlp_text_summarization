    style TOKENIZE fill:#2d3748,stroke:#f6ad55,color:#fff
    style ENCODE fill:#2d3748,stroke:#f6ad55,color:#fff
    style GENERATE fill:#2d3748,stroke:#ed8936,color:#fff
    style BEAM fill:#1a202c,stroke:#ed8936,color:#fff
    style STOP fill:#2d3748,stroke:#fbd38d,color:#fff
    style DECODE fill:#742a2a,stroke:#f6ad55,color:#fff